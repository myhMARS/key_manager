            Button:
                text: 'Save'
                size_hint_x: None
                width: dp(80)
                color: 1, 1, 1, 1
                font_size: '14sp'
                bold: True
                on_release: root.on_save()
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: root.accent_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]


