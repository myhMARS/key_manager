<ConfirmDeletePlatformPopup>:
    title: ''
    separator_height: 0
    size_hint: 0.85, None
    height: dp(240)
    auto_dismiss: True
    background: ''
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.4

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20), dp(16), dp(20), dp(16)
        spacing: dp(12)
        size_hint: 1, 1
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16)]

        # Warning icon + title
        BoxLayout:
            size_hint_y: None
            height: dp(26)
            spacing: dp(8)

            Label:
                text: '!'
                font_size: '14sp'
                bold: True
                color: 0.9, 0.2, 0.2, 1
                size_hint: None, None
                size: dp(22), dp(22)
                halign: 'center'
                valign: 'middle'
                text_size: self.size
                canvas.before:
                    Color:
                        rgba: 0.95, 0.9, 0.9, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size

            Label:
                text: 'Delete ' + root.platform_name + '?'
                font_size: '15sp'
                bold: True
                color: 0.15, 0.15, 0.15, 1
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                text_size: self.width, self.height

        # Description
        Label:
            text: root.key_count_text
            font_size: '13sp'
            color: 0.45, 0.45, 0.45, 1
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            valign: 'top'
            text_size: self.width, None

        Widget:
            size_hint_y: 1

        # Buttons
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(12)

            Button:
                text: 'Cancel'
                size_hint_x: 1
                color: 0.3, 0.3, 0.3, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                font_size: '14sp'
                on_release: root.dismiss()
                canvas.before:
                    Color:
                        rgba: 0.94, 0.94, 0.94, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

            Button:
                text: 'Delete'
                size_hint_x: 1
                color: 1, 1, 1, 1
                font_size: '14sp'
                bold: True
                on_release: root.on_confirm()
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.9, 0.2, 0.2, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]


