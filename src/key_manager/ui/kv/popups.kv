#:import dp kivy.metrics.dp

<AddKeyPopup>:
    title: ''
    separator_height: 0
    size_hint: 0.9, None
    height: dp(320)
    auto_dismiss: True
    background: ''
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.4

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(14)
        size_hint: 1, 1
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16)]

        BoxLayout:
            size_hint_y: None
            height: dp(32)
            spacing: dp(10)

            Label:
                text: '+'
                font_size: '18sp'
                size_hint_x: None
                width: dp(28)
                color: root.accent_color

            Label:
                text: 'Add ' + root.platform_name + ' Key'
                font_size: '16sp'
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_x: 1
                halign: 'left'
                text_size: self.width, None

        TextInput:
            id: name_input
            hint_text: 'Key Name (e.g. Work account)'
            font_size: '14sp'
            size_hint_y: None
            height: dp(48)
            multiline: False
            write_tab: False
            background_normal: ''
            background_active: ''
            background_color: 0.96, 0.96, 0.96, 1
            cursor_color: 0.3, 0.3, 0.3, 1
            foreground_color: 0.1, 0.1, 0.1, 1
            hint_text_color: 0.6, 0.6, 0.6, 1
            padding: [dp(12), dp(14), dp(12), dp(12)]

        TextInput:
            id: key_input
            hint_text: 'API Key'
            font_size: '14sp'
            size_hint_y: None
            height: dp(48)
            multiline: False
            password: True
            write_tab: False
            background_normal: ''
            background_active: ''
            background_color: 0.96, 0.96, 0.96, 1
            cursor_color: 0.3, 0.3, 0.3, 1
            foreground_color: 0.1, 0.1, 0.1, 1
            hint_text_color: 0.6, 0.6, 0.6, 1
            padding: [dp(12), dp(14), dp(12), dp(12)]

        Label:
            id: error_label
            text: ''
            font_size: '12sp'
            color: 0.9, 0.2, 0.2, 1
            size_hint_y: None
            height: dp(18)
            halign: 'left'
            text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            Widget:
                size_hint_x: 1

            Button:
                text: 'Cancel'
                size_hint_x: None
                width: dp(80)
                color: 0.4, 0.4, 0.4, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                font_size: '14sp'
                on_release: root.dismiss()

            Button:
                text: 'Save'
                size_hint_x: None
                width: dp(80)
                color: 1, 1, 1, 1
                font_size: '14sp'
                bold: True
                on_release: root.on_save()
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: root.accent_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]


