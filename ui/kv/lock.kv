#:import dp kivy.metrics.dp

<LockScreen>:
    name: 'lock'

    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.96, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id: lock_content
        orientation: 'vertical'
        padding: dp(32), dp(60), dp(32), dp(32)
        spacing: dp(16)

        Widget:
            size_hint_y: 1

        Label:
            text: 'Set Password' if root.is_setup else 'Unlock'
            font_size: '22sp'
            bold: True
            color: 0.1, 0.1, 0.1, 1
            size_hint_y: None
            height: dp(32)
            halign: 'center'
            text_size: self.width, None

        Label:
            text: 'Create a password to protect your keys' if root.is_setup else 'Enter your password'
            font_size: '13sp'
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: None
            height: dp(20)
            halign: 'center'
            text_size: self.width, None

        Widget:
            size_hint_y: None
            height: dp(16)

        TextInput:
            id: password_input
            hint_text: 'Password'
            font_size: '16sp'
            size_hint_y: None
            height: dp(52)
            multiline: False
            password: True
            password_mask: '*'
            write_tab: False
            input_type: 'text'
            suggestion_text: ''
            background_normal: ''
            background_active: ''
            background_color: 1, 1, 1, 1
            cursor_color: 0, 0, 0, 1
            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1
            padding: [dp(16), dp(15), dp(16), dp(13)]
            canvas.after:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(10)]
                    width: 1.2

        TextInput:
            id: confirm_input
            hint_text: 'Confirm Password'
            font_size: '16sp'
            size_hint_y: None
            height: dp(52) if root.is_setup else 0
            opacity: 1 if root.is_setup else 0
            disabled: not root.is_setup
            multiline: False
            password: True
            password_mask: '*'
            write_tab: False
            input_type: 'text'
            suggestion_text: ''
            background_normal: ''
            background_active: ''
            background_color: 1, 1, 1, 1
            cursor_color: 0, 0, 0, 1
            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1
            padding: [dp(16), dp(15), dp(16), dp(13)]
            canvas.after:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1 if root.is_setup else 0
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(10)]
                    width: 1.2

        Label:
            text: root.error_text
            font_size: '12sp'
            color: 0.9, 0.2, 0.2, 1
            size_hint_y: None
            height: dp(20)
            halign: 'center'
            text_size: self.width, None

        Button:
            text: 'Set Password' if root.is_setup else 'Unlock'
            size_hint_y: None
            height: dp(48)
            font_size: '15sp'
            bold: True
            color: 1, 1, 1, 1
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            on_release: root.on_submit()
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]

        # Fingerprint button (only visible when biometric is available)
        AnchorLayout:
            size_hint_y: None
            height: dp(56) if root.biometric_available else 0
            opacity: 1 if root.biometric_available else 0
            anchor_x: 'center'

            Button:
                text: 'Use Fingerprint'
                size_hint: None, None
                size: dp(160), dp(40)
                font_size: '13sp'
                color: 0.3, 0.3, 0.3, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                disabled: not root.biometric_available
                on_release: root.on_biometric_tap()

        Widget:
            size_hint_y: 1.5
