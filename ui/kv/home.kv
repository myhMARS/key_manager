#:import dp kivy.metrics.dp

<HomeScreen>:
    name: 'home'

    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.96, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Main content
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16), dp(12), dp(16), dp(8)
        spacing: dp(0)
        pos: root.pos
        size: root.size

        # Title row
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)

            Label:
                text: 'Key Manager'
                font_size: '22sp'
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_x: 1
                halign: 'left'
                valign: 'middle'
                text_size: self.width, self.height

            Button:
                text: '+'
                size_hint: None, None
                size: dp(34), dp(34)
                pos_hint: {'center_y': 0.5}
                font_size: '20sp'
                color: 0.4, 0.4, 0.4, 1
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                on_release: root.show_add_platform()
                canvas.before:
                    Color:
                        rgba: 0.92, 0.92, 0.92, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

        # Global search bar
        TextInput:
            id: global_search
            hint_text: 'Search all keys...'
            font_size: '13sp'
            size_hint_y: None
            height: dp(36)
            multiline: False
            write_tab: False
            background_normal: ''
            background_active: ''
            background_color: 0.92, 0.92, 0.92, 1
            cursor_color: 0.2, 0.2, 0.2, 1
            foreground_color: 0.1, 0.1, 0.1, 1
            hint_text_color: 0.5, 0.5, 0.5, 1
            padding: [dp(12), dp(9), dp(12), dp(7)]
            on_text: root.on_global_search(self.text)

        # Card area
        RelativeLayout:
            id: card_area
            size_hint_y: 1

        # Dots indicator
        Widget:
            size_hint_y: None
            height: dp(6)

        AnchorLayout:
            size_hint_y: None
            height: dp(20)
            anchor_x: 'center'
            anchor_y: 'center'

            BoxLayout:
                id: dots_container
                orientation: 'horizontal'
                size_hint: None, None
                height: dp(10)
                width: self.minimum_width
                spacing: dp(6)

        Widget:
            size_hint_y: None
            height: dp(4)

    # Floating search results overlay (on top of cards)
    ScrollView:
        id: search_results_scroll
        size_hint: None, None
        width: root.width - dp(32)
        height: 0
        pos: dp(16), root.height - dp(44) - dp(36) - dp(12) - self.height
        do_scroll_x: False

        BoxLayout:
            id: search_results
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(2)
            padding: dp(4)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.98
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8)]
                Color:
                    rgba: 0.85, 0.85, 0.85, 1
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(8)]
                    width: 1
